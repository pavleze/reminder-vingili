// Firestore rules for the Todays web app.
// ADD these two `match` blocks inside your existing `match /databases/{database}/documents { ... }`
// (keep the rules the old Android app already has for `users`).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // profile: name, email (so a partner can find you), settings, linked partner
    match /todays_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // tasks and lists; `members` = who can see it (owner + partner when shared)
    match /todays_items/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
